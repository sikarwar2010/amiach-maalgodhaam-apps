# ─────────────────────────────────────────────────────────────────────────────
# MaalGodaam — environment variables (copy to .env and fill in; never commit .env)
# The API and the Prisma CLI read the repo-root .env. The web app reads apps/web/.env.local
# (see apps/web/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (local dev: `docker compose up -d` starts one on port 5433)
DATABASE_URL="postgresql://maalgodaam:maalgodaam_dev@localhost:5433/maalgodaam?schema=public"

# Clerk — https://dashboard.clerk.com (enable Email + Google under "User & Authentication")
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# API server
API_PORT=4100
# Public URL of this API (used to build uploaded-file URLs) and the web origin(s) allowed by CORS / Clerk `azp`.
PUBLIC_API_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
# Set true only when running behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Local file storage for uploads (swap for S3/R2 in production).
UPLOAD_DIR=./uploads

# Operator bootstrap: these e-mails become SUPER_ADMIN the first time they use the app, but only once Clerk
# reports the address as VERIFIED. Set this in EVERY environment (local, staging, production).
SUPER_ADMIN_EMAILS=sikarwar2010@gmail.com

# Making someone else an admin: sign in as a SUPER_ADMIN → Admin console → Users → change their role.
# (Clerk public metadata { "role": ... } is only read when a user's database row is first created;
# after that the database is the source of truth.) Roles are never taken from the browser.

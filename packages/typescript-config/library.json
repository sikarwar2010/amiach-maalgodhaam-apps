{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Source-exported library (consumed by Bun / Next bundlers)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "verbatimModuleSyntax": true
  }
}

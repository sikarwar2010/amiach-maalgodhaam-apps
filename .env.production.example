# ─────────────────────────────────────────────────────────────────────────────
# Production environment — Dokploy "Docker Compose" application.
#
# Paste this (with real values, no comments needed) into that application's Environment tab.
# Dokploy writes it to a `.env` file next to docker-compose.prod.yml on the server; that file is
# what fills in every `${VAR}` in the compose file, for BOTH the api and web services — there is
# only one environment box for the whole compose stack, not one per service.
#
# Never commit a real .env file. Real secrets live only in Dokploy (and in your password manager).
# ─────────────────────────────────────────────────────────────────────────────

# ---- Database -----------------------------------------------------------------
# Create the database as its own Dokploy "Database" resource (Postgres 16+), then paste its
# Internal Connection URL here — NOT the External one (that's for connecting from your own laptop
# with a client like psql/TablePlus, and is unnecessary latency/exposure for the app itself).
DATABASE_URL=

# ---- Clerk (https://dashboard.clerk.com) ---------------------------------------
# Use a PRODUCTION Clerk instance (not the development one this repo was built against) once you
# have a real domain — development instances have strict usage limits and show a "development
# mode" pill in the UI.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the webhook endpoint you create at:  https://api.yourdomain.com/api/webhooks/clerk
# (events: user.created, user.updated, user.deleted). See DEPLOY.md step 6.
CLERK_WEBHOOK_SECRET=

# ---- Operator bootstrap ---------------------------------------------------------
# Comma-separated e-mails that become SUPER_ADMIN the first time they sign in with a VERIFIED
# address of that e-mail. Set this before the first deploy so you can reach /admin immediately.
SUPER_ADMIN_EMAILS=

# ---- Public URLs -----------------------------------------------------------------
# The web app's origin(s), comma-separated — used for the API's CORS allow-list and Clerk's `azp`
# check. Include both apex and www if you serve both.
WEB_ORIGIN=https://yourdomain.com
# This API's own public URL — used to build the URLs of files it serves (product images, vendor
# documents). Must be the domain you point at the `api` service in Dokploy's Domains tab.
PUBLIC_API_URL=https://api.yourdomain.com
# The BROWSER's URL for the API. Same value as PUBLIC_API_URL — kept separate because the web app
# reads this one (it is also baked into the built JS bundle; changing it needs a redeploy).
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ---- Optional overrides -----------------------------------------------------------
# API_PORT=4100

# Web app (Next.js) — copy to apps/web/.env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the Hono API lives. NEXT_PUBLIC_* is used by the browser, API_URL by the Next server (can be an internal address).
NEXT_PUBLIC_API_URL=http://localhost:4100
API_URL=http://localhost:4100

# Routes (already wired in the app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/register
